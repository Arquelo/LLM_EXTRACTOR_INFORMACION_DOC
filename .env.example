# Copia este archivo a `.env` en la raíz del repo (o a `backend/.env`).

# Extractor activo (clave en extractors.EXTRACTORES)
EXTRACTOR=constancia_situacion_fiscal

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_RETRIES=2
OLLAMA_RETRY_BACKOFF=1.5

# API
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Límites de carga / PDF
MAX_UPLOAD_FILES=20
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=50
MAX_PDF_CHARS=120000
